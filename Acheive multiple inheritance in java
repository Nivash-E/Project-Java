    interface Readable{
        void read();
    }

    interface Writable{
        void write();
    }

    interface Storable{
        void store();
    }

    class File implements Readable,Writable,Storable{
        @Override
        public  void read(){
            System.out.println("Readed");
        }

         public void write(){
            System.out.println("Writed");
        }

         public void store(){
            System.out.println("Stored");
        }
    }
    
    public class Interface{
        public static void main(String[] args) {
                File f1=new File();
                f1.read();
                f1.write();
                f1.store();
        }
    }
